<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_task_report" model="ir.actions.report">
        <field name="name">Project Details</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_task.report_project_task</field>
        <field name="report_file">report_project_task</field>
        <field name="binding_model_id" ref="model_task_report"/>
    </record>

    <template id="report_project_task">

        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <h2 style="margin-left:350px">Task Report </h2>
                <div class="page">
                    <div class="oe_structure"/>

                    <table border="1" style="width:100%;" name="consultation">
                        <thead>
                            <tr>
<!--                                <th>-->
<!--                                     Id-->
<!--                                </th>-->
                                <th>
                                     Task
                                </th>
                                <th>
                                    Date
                                </th>
                                <th>
                                    Description
                                </th>
                            </tr>
                        </thead>


                        <t t-if="tasks">

                            <t t-foreach="tasks" t-as="o">

                                <tr style="font-weight:bold;">
<!--                                    <td>-->
<!--                                        <t t-esc="o['id']"/>-->
<!--                                    </td>-->
                                    <td>
                                        <t t-esc="o['task']"/>

                                    </td>

                                    <td>
                                        <t t-esc="o['date']"/>

                                    </td>
                                    <td>
                                        <t t-esc="o['description']"/>

                                    </td>
                                </tr>
                            </t>
                        </t>

                    </table>





                </div>

            </t>

        </t>
    </template>
</odoo>